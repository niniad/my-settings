      "args": ["-y", "@toolbox-sdk/server", "--prebuilt", "bigquery", "--stdio"],
      "env": {
        "BIGQUERY_LOCATION": "us-central1",
        "BIGQUERY_PROJECT": "main-project-477501"
      }
    },
    "mermaid": {
